{
  "name": "spamanagement",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:local": "bash scripts/local-db.sh",
    "db:generate": "pnpm --filter @spa/db generate",
    "db:migrate": "pnpm --filter @spa/db migrate",
    "db:seed": "pnpm --filter @spa/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
