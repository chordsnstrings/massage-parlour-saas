# Root .env — loaded by web (next.config), db scripts and worker.
ROOT_DOMAIN=localhost:3000            # prod: spamanagement.ae
APP_URL=http://app.localhost:3000     # prod: https://app.spamanagement.ae
ADMIN_URL=http://admin.localhost:3000 # prod: https://admin.spamanagement.ae

# Postgres roles (see packages/db/sql/bootstrap.sql)
DATABASE_URL_OWNER=postgres://spa_owner:spa_owner_dev@localhost:5432/spa       # migrations + pg-boss
DATABASE_URL_PLATFORM=postgres://spa_platform:spa_platform_dev@localhost:5432/spa # auth, super-admin, host lookup
DATABASE_URL_APP=postgres://spa_app:spa_app_dev@localhost:5432/spa             # tenant data, RLS enforced

BETTER_AUTH_SECRET=change-me-32-bytes-min-change-me-32
PLATFORM_ADMIN_EMAILS=you@example.com # comma-separated; promoted to super-admin on sign-up/seed

# Optional
RESEND_API_KEY=
EMAIL_FROM="spamanagement.ae <no-reply@spamanagement.ae>"
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Integration tokens at rest (32 bytes base64; falls back to a key derived from BETTER_AUTH_SECRET)
APP_ENCRYPTION_KEY=

# File storage: Postgres by default; set these to use Cloudflare R2 / DigitalOcean Spaces instead
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Instagram (Meta app with Instagram API with Instagram Login)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# R7 Meta MCP (optional): token secret (default BETTER_AUTH_SECRET) and an out-of-process server URL (default in-process)
META_MCP_SECRET=
META_MCP_URL=

# Google Business Profile (OAuth client, Business Profile APIs enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom domains via Cloudflare for SaaS (zone that owns the fallback origin)
CF_API_TOKEN=
CF_ZONE_ID=
CF_CNAME_TARGET=                  # e.g. customers.spamanagement.ae

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@spamanagement.ae

# Error reporting (Sentry-compatible DSN; optional)
SENTRY_DSN=
