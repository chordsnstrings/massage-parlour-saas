# Root .env — loaded by web (next.config), db scripts and worker.
ROOT_DOMAIN=localhost:3000            # prod: spamanagement.co
APP_URL=http://app.localhost:3000     # prod: https://app.spamanagement.co
ADMIN_URL=http://admin.localhost:3000 # prod: https://admin.spamanagement.co
EXTRA_ROOT_DOMAINS=                   # prod: spamanagement.ae (old domain keeps working)

# Postgres roles (see packages/db/sql/bootstrap.sql)
DATABASE_URL_OWNER=postgres://spa_owner:spa_owner_dev@localhost:5432/spa       # migrations + pg-boss
DATABASE_URL_PLATFORM=postgres://spa_platform:spa_platform_dev@localhost:5432/spa # auth, super-admin, host lookup
DATABASE_URL_APP=postgres://spa_app:spa_app_dev@localhost:5432/spa             # tenant data, RLS enforced

BETTER_AUTH_SECRET=change-me-32-bytes-min-change-me-32
PLATFORM_ADMIN_EMAILS=you@example.com # comma-separated; promoted to super-admin on sign-up/seed
# Who may edit spa sites with prompts (Studio "Ask AI" + the Claude MCP connector /api/mcp). Comma-separated; each must
# also be a super-admin with 2FA. Empty = nobody. Set it to the owner's own email.
SITE_AI_EDITOR_EMAILS=
# Claude connector: OAuth redirect URIs a client may register (exact, comma-separated). Empty = Claude's own callbacks
# (https://claude.ai/api/mcp/auth_callback, https://claude.com/api/mcp/auth_callback). Only change if Claude does.
MCP_REDIRECT_URIS=

# Optional
RESEND_API_KEY=
EMAIL_FROM="spamanagement.ae <no-reply@spamanagement.ae>"  # B1: switch to .co once verified in Resend
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Off-site DB backups (worker db-backup + restore-drill). Unset → falls back to the S3_* bucket (backups/ prefix);
# a separate private bucket is recommended.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Monthly restore drill: a role with CREATEDB for the scratch database (default DATABASE_URL_OWNER)
RESTORE_DRILL_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# Integration tokens at rest (32 bytes base64; falls back to a key derived from BETTER_AUTH_SECRET)
APP_ENCRYPTION_KEY=

# File storage: Postgres by default; set these to use Cloudflare R2 / DigitalOcean Spaces instead
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Instagram (Meta app with Instagram API with Instagram Login)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# R7 Meta MCP (optional): token secret (default BETTER_AUTH_SECRET) and an out-of-process server URL (default in-process)
META_MCP_SECRET=
META_MCP_URL=

# Google Business Profile (OAuth client, Business Profile APIs enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom domains via Cloudflare for SaaS (zone that owns the fallback origin)
CF_API_TOKEN=
CF_ZONE_ID=
CF_CNAME_TARGET=                  # e.g. customers.spamanagement.co

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ask@spamanagement.co

# Bot check on public forms (F9): Cloudflare Turnstile widget keys (Cloudflare → Turnstile → Add widget, Managed).
# Unset = online booking, the widget, Apply and Contact run without it (dev/test; production flags it red in the console).
# Local testing: Cloudflare's always-pass test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_CUSTOM_DOMAINS=          # on = also on spas' custom domains (add each domain to the widget's hostnames first)

# Error reporting (Sentry-compatible DSN; optional)
SENTRY_DSN=
