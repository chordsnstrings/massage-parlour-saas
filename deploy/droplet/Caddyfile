{
	email {$ACME_EMAIL:ops@spamanagement.co}
	# Spa custom domains: certificates are issued on first visit, only for hostnames the app has registered.
	on_demand_tls {
		ask http://web:3000/api/domains/allowed
	}
	# Client IP: port 443 is open to everyone (custom domains), so Cf-Connecting-Ip / X-Forwarded-For are trusted only
	# from Cloudflare's edge (https://www.cloudflare.com/ips/, update when Cloudflare changes them). Every proxied
	# request below overwrites Cf-Connecting-Ip with that resolved IP, so the app's per-IP rate limits and audit IPs
	# can't be forged by a client that reaches the droplet directly.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(proxy_to_web) {
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up Cf-Connecting-Ip {client_ip}
		header_up -Do-Connecting-Ip
	}
}

{$SITE_HOST} {
	encode zstd gzip
	# Largest legitimate body is a 20 MB image upload; the app enforces exact limits per route.
	request_body {
		max_size 25MB
	}

	# Deploy status + recent logs for the operator (basic auth; no secrets are written there).
	handle /_status/* {
		basic_auth {
			{$STATUS_USER:ops} {$STATUS_HASH}
		}
		root * /srv
		file_server
	}

	handle {
		import proxy_to_web
	}
}

# Any other hostname = a spa's custom domain (the app routes it to that spa's site).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	# Largest legitimate body is a 20 MB image upload; the app enforces exact limits per route.
	request_body {
		max_size 25MB
	}
	import proxy_to_web
}
