# Public settings for the production droplet. Plain text in git: NEVER put a secret here (secrets.env.enc is for those).
# update.sh rebuilds /opt/spa/.env on every deploy: first-boot env < secrets.env.enc < this file (a line here wins).
# Only these keys apply: SITE_HOST ROUTING APP_URL ADMIN_URL EXTRA_ROOT_DOMAINS ACME_EMAIL VAPID_SUBJECT
# CF_CNAME_TARGET EMAIL_FROM. Any other line is skipped (logged in /_status/build.log). CI (test-update.sh) checks
# this file: allowed keys only, and SITE_HOST, ROUTING, APP_URL and ADMIN_URL set together and matching.
# A commented-out line = the first-boot value (134-209-145-162.sslip.io, path routing).
# Rollback: the updater redeploys the last good commit with that commit's copy of this file.

# The move to spamanagement.co (deploy/droplet/README.md "Move to spamanagement.co"):
SITE_HOST=spamanagement.co
ROUTING=host
APP_URL=https://app.spamanagement.co
ADMIN_URL=https://admin.spamanagement.co
# The old address keeps working (its /app, /admin and /s/{slug} links redirect to the new domain).
EXTRA_ROOT_DOMAINS=134-209-145-162.sslip.io
ACME_EMAIL=ask@spamanagement.co
VAPID_SUBJECT=mailto:ask@spamanagement.co
# Where spas point their own domain's CNAME (resolves through the * record).
CF_CNAME_TARGET=customers.spamanagement.co

# Staff email sender: set it to "spamanagement.co <ask@spamanagement.co>" once Resend has verified the domain
# (the built-in default is already that address; nothing is sent before the Resend key is added).
# EMAIL_FROM="spamanagement.co <ask@spamanagement.co>"
