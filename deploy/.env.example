# /opt/spa/.env on the droplet (chmod 600). Never commit real values.
TAG=latest                      # image tag; the deploy workflow rewrites this
GHCR_OWNER=chordsnstrings
ROOT_DOMAIN=spamanagement.ae
PLATFORM_ADMIN_EMAILS=you@example.com

POSTGRES_SUPERUSER_PASSWORD=   # openssl rand -base64 32
SPA_OWNER_PASSWORD=
SPA_PLATFORM_PASSWORD=
SPA_APP_PASSWORD=
BETTER_AUTH_SECRET=            # openssl rand -base64 48

CLOUDFLARE_TUNNEL_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="spamanagement.ae <no-reply@spamanagement.ae>"
ARK_API_KEY=

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=spa-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
