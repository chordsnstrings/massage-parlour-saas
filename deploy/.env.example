# /opt/spa/.env on the droplet (chmod 600). Never commit real values.
TAG=latest                      # image tag; the deploy workflow rewrites this
GHCR_OWNER=chordsnstrings
ROOT_DOMAIN=spamanagement.co
EXTRA_ROOT_DOMAINS=134-209-145-162.sslip.io   # old address keeps working
PLATFORM_ADMIN_EMAILS=you@example.com

POSTGRES_SUPERUSER_PASSWORD=   # openssl rand -base64 32
SPA_OWNER_PASSWORD=
SPA_PLATFORM_PASSWORD=
SPA_APP_PASSWORD=
BETTER_AUTH_SECRET=            # openssl rand -base64 48

RESEND_API_KEY=
EMAIL_FROM="spamanagement.co <ask@spamanagement.co>"  # the default; Resend sends once .co is verified
ARK_API_KEY=

R2_ENDPOINT=https://<region>.digitaloceanspaces.com   # DigitalOcean Spaces (recommended)
R2_REGION=<region>                                   # e.g. blr1
R2_BUCKET=spa-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
